var LED = {
    "0": " _ ,| |,|_|",
    "1": "   ,  |,  |",
    "2": " _ , _|,|_ ",
    "3": " _ , _|, _|",
    "4": "   ,|_|,  |",
    "5": " _ ,|_ , _|",
    "6": " _ ,|_ ,|_|",
    "7": " _ ,  |,  |",
    "8": " _ ,|_|,|_|",
    "9": " _ ,|_|, _|"
};

var num = input("Enter a number: ");

for (var i = 0; i < 3; i += 1) {
    var row = "";

    for (var j = 0; j < num.len(); j += 1) {
        var line = LED[num[j]].split(",");
        row += line[i] + " ";
    }

    print(row);
}
