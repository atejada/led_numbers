import basics

func led_pattern(digit ubyte) String {
    if digit == 48 return " _  ,| | ,|_| "
    if digit == 49 return "    , |  , |  "
    if digit == 50 return " _  , _| ,|_  "
    if digit == 51 return " _  , _| , _| "
    if digit == 52 return "    ,|_| ,  | "
    if digit == 53 return " _  ,|_  , _| "
    if digit == 54 return " _  ,|_  ,|_| "
    if digit == 55 return "_   , |  , |  "
    if digit == 56 return " _  ,|_| ,|_| "
    if digit == 57 return " _  ,|_| , _| "

    return ""
}

func main {
    number, pattern String
    line1, line2, line3 String
    leds <String> List
    
	printf("Enter a number: ")
	number = gets()

	for(i int = 0; i < number.length; i += 1) {
		pattern = led_pattern(number[i])
		leds = split(&pattern, ",")
		line1 = line1 + leds[0]
		line2 = line2 + leds[1]
		line3 = line3 + leds[2]
	}
	
	print(line1)
	print(line2)
	print(line3)
}
